# Driver Insight Agent Environment Variables

# API Configuration
API_BASE_URL=https://external.driver.api
API_TIMEOUT=30
API_MAX_RETRIES=3

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL=600
CACHE_TYPE=memory
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# MCP Tool Server
MCP_TOOL_SERVER_URL=http://localhost:8081/mcp-tools
MCP_TOOL_SERVER_TIMEOUT=10
MCP_ENABLED=true

# Service Configuration
SERVICE_PORT=8080
SERVICE_HOST=0.0.0.0
LOG_LEVEL=INFO
LOG_FORMAT=json
