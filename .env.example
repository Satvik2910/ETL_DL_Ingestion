# Driver Insight Agent Configuration
# Copy this file to .env and customize the values

# API Configuration
DIA_API__BASE_URL=https://external.driver.api
DIA_API__PAGINATION_SIZE=100
DIA_API__MAX_RETRIES=3
DIA_API__TIMEOUT=30
DIA_API__RETRY_DELAY=1.0

# Cache Configuration
DIA_CACHE__TTL=600
DIA_CACHE__TYPE=memory
# DIA_CACHE__TYPE=redis
# DIA_CACHE__REDIS_URL=redis://localhost:6379/0
DIA_CACHE__MAX_SIZE=1000

# MCP Tools Configuration
DIA_MCP_TOOLS__SERVER_URL=http://localhost:8081/mcp-tools
DIA_MCP_TOOLS__TIMEOUT=10
DIA_MCP_TOOLS__MAX_RETRIES=2

# Validation Configuration
DIA_VALIDATION__REQUIRED_FIELDS=["driver_id", "name"]

# Logging Configuration
DIA_LOGGING__LEVEL=INFO
DIA_LOGGING__FORMAT=json
# DIA_LOGGING__FILE=/var/log/driver-insight-agent.log

# Server Configuration
DIA_SERVER__HOST=0.0.0.0
DIA_SERVER__PORT=8080
DIA_SERVER__DEBUG=false
DIA_SERVER__WORKERS=1